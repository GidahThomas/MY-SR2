# Copy to .env and adjust. Values already set in the real environment win,
# so `set PORT=9000 && npm start` still overrides this file.
HOST=127.0.0.1
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=university
DB_USER=root
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=10

# How long a sign-in stays valid.
SESSION_TTL_HOURS=8

# Salt for the scrypt password hashes. Changing it invalidates every stored
# password, including the seeded demo accounts - reseed after changing it.
PASSWORD_SALT=usiams-demo-salt
