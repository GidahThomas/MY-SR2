# Copy to .env and adjust. Values already set in the real environment win,
# so `set PORT=9000 && npm start` still overrides this file.
HOST=127.0.0.1
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=university
DB_USER=root
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=10

# How long a sign-in stays valid at most, and after how long without
# activity it ends (a computer left signed in in a lab).
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=60

# Every password now gets its own random salt. This value is only used to
# check hashes written before that change; each is upgraded the next time
# its account signs in. Leave it as it was until they all have.
PASSWORD_SALT=usiams-demo-salt

# The address users reach the site at, for links in emails (password
# reset). Defaults to the address the request came in on.
# PUBLIC_URL=https://usiams.example.ac.tz

# The institution shown on the public home page. Anything left unset is
# simply left off the page. PUBLIC_URL above is also used for the link
# preview (og:image) that WhatsApp and social media show, so set it.
# UNIVERSITY_NAME=The University of Example
# CONTACT_EMAIL=admissions@example.ac.tz
# CONTACT_PHONE=+255 26 000 0000
# CONTACT_ADDRESS=P.O. Box 000, Dodoma, Tanzania
# CONTACT_WEBSITE=example.ac.tz
# OFFICE_HOURS=Mon - Fri, 08:00 - 16:00
# Crest and campus photo: put the files under assets/images/.
# SITE_LOGO=assets/images/crest.png
# CAMPUS_PHOTO=assets/images/campus.jpg
# Admission window (YYYY-MM-DD).
# ADMISSION_OPENS=2026-06-01
# ADMISSION_CLOSES=2026-08-31

# HTTPS. Set both to serve TLS directly; leave unset when a proxy (nginx,
# IIS, a load balancer) terminates HTTPS in front of this server.
# TLS_CERT_FILE=C:\certs\usiams.crt
# TLS_KEY_FILE=C:\certs\usiams.key

# Outgoing email (password reset links, admission decisions). Without
# SMTP_HOST, emails are kept in the outbound_messages table and printed to
# the server console instead of being sent.
# SMTP_HOST=smtp.example.ac.tz
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usiams@example.ac.tz
# SMTP_PASSWORD=change-me
# SMTP_FROM=USIAMS <usiams@example.ac.tz>

# Daily timetable reminders (morning summary, 15 minutes before each class,
# evening prompt to finish the checklist). Set to off to disable.
# REMINDERS=on

# Reminder times use this machine's local time. Set the university's time
# zone if the server runs elsewhere.
# APP_TIMEZONE=Africa/Dar_es_Salaam

# A cloud database (as used with Vercel, see DEPLOY.md) needs an encrypted
# connection. DB_SSL_CA is the provider's CA certificate, if it has its own.
# DB_SSL=on
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# GePG is not connected yet. With GEPG_SIMULATION=on a student can press
# "Confirm Payment" and the bill is marked paid - for demonstrations ONLY,
# since it lets a student mark their own fees paid. Leave it off on a real
# system: finance staff confirm payments after checking them in GePG.
# GEPG_SIMULATION=off

# Set to on only if the server sits behind a proxy (Vercel, nginx, IIS...)
# that sets X-Forwarded-For. Otherwise clients could fake their address in
# the audit log and get round the sign-in attempt limits.
# TRUST_PROXY=off
