# Copy to .env and adjust. Values already set in the real environment win,
# so `set PORT=9000 && npm start` still overrides this file.
HOST=127.0.0.1
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=university
DB_USER=root
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=10

# How long a sign-in stays valid.
SESSION_TTL_HOURS=8

# Every password now gets its own random salt. This value is only used to
# check hashes written before that change; each is upgraded the next time
# its account signs in. Leave it as it was until they all have.
PASSWORD_SALT=usiams-demo-salt

# The address users reach the site at, for links in emails (password
# reset). Defaults to the address the request came in on.
# PUBLIC_URL=https://usiams.example.ac.tz

# HTTPS. Set both to serve TLS directly; leave unset when a proxy (nginx,
# IIS, a load balancer) terminates HTTPS in front of this server.
# TLS_CERT_FILE=C:\certs\usiams.crt
# TLS_KEY_FILE=C:\certs\usiams.key

# Outgoing email (password reset links, admission decisions). Without
# SMTP_HOST, emails are kept in the outbound_messages table and printed to
# the server console instead of being sent.
# SMTP_HOST=smtp.example.ac.tz
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usiams@example.ac.tz
# SMTP_PASSWORD=change-me
# SMTP_FROM=USIAMS <usiams@example.ac.tz>

# Daily timetable reminders (morning summary, 15 minutes before each class,
# evening prompt to finish the checklist). Set to off to disable.
# REMINDERS=on

# Reminder times use this machine's local time. Set the university's time
# zone if the server runs elsewhere.
# TZ=Africa/Dar_es_Salaam
