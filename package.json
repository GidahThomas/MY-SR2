{
  "name": "usiams",
  "version": "1.0.0",
  "private": true,
  "description": "USIAMS university student information and academic management system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js",
    "db:schema": "node db/run-sql.js db/schema.sql",
    "db:migrate": "node db/run-sql.js db/migration-full-app.sql",
    "db:seed": "node db/seed-from-data.js",
    "db:setup": "npm run db:schema && npm run db:migrate && npm run db:seed",
    "test": "node tests/run.js"
  },
  "dependencies": {
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "jsdom": "^30.1.1"
  }
}
